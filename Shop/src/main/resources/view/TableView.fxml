<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500.0" prefWidth="700.0" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TableController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20.0">
        <Label text="General View">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Button onAction="#handleRefrescar" text="🔄 Update" />
    </HBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <Tab text="Customer List">
            <AnchorPane>
                <TableView fx:id="tablaClientes" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <columns>
                        <TableColumn fx:id="colIdCli" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colNombre" prefWidth="100.0" text="Name" />
                        <TableColumn fx:id="colCliente" prefWidth="120.0" text="Customer" />
                        <TableColumn fx:id="colEmail" prefWidth="150.0" text="Email" />
                        <TableColumn fx:id="colVip" prefWidth="60.0" text="VIP" />
                        <TableColumn fx:id="colFechaAlta" prefWidth="100.0" text="Registration Date" />
                    </columns>
                </TableView>
            </AnchorPane>
        </Tab>

        <Tab text="View Orders">
            <AnchorPane>
                <TableView fx:id="tablaPedidos" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <columns>
                        <TableColumn fx:id="colIdPed" prefWidth="60.0" text="ID" />
                        <TableColumn fx:id="colFechaPed" prefWidth="100.0" text="Date" />
                        <TableColumn fx:id="colImporte" prefWidth="80.0" text="Price (€)" />
                        <TableColumn fx:id="colPagado" prefWidth="70.0" text="Paid" />
                        <TableColumn fx:id="colIdClienteFK" prefWidth="70.0" text="ID Customer" />
                    </columns>
                </TableView>
            </AnchorPane>
        </Tab>

    </TabPane>
</VBox>