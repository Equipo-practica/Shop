<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">
    <padding>
        <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
    </padding>

    <Label text="Gestión de Shop">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <Label text="Seleccione una opción:" textFill="#666666" />

    <Button fx:id="btnGestionClientes" maxWidth="200.0" mnemonicParsing="false" onAction="#handleGestionClientes" text="Gestión de Clientes (CRUD)">
        <font>
            <Font size="14.0" />
        </font>
    </Button>

    <Button fx:id="btnVerTablas" maxWidth="200.0" mnemonicParsing="false" onAction="#handleVerTablas" text="Ver Tablas y Pedidos">
        <font>
            <Font size="14.0" />
        </font>
    </Button>
</VBox>